              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/v1/reservations/{{faultReservationUid}}"
          }
        },
        {
          "name": "Profile keeps loyalty",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Profile keeps loyalty\", () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().loyalty.status).to.be.a(\"string\");",
                  "  pm.response.json().reservations.forEach(r => pm.expect(r.payment).to.deep.equal({}));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-User-Name",
                "value": "{{faultUser}}"
